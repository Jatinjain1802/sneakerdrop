# MySQL connection string (TiDB Cloud, Aiven, PlanetScale, local MySQL...)
DATABASE_URL=mysql://user:password@host:3306/dbname
# Admin login
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password: npm run hash -- 'a-long-password'
ADMIN_PASSWORD_HASH=
# Random string, 32+ chars, signs the admin session cookie: openssl rand -hex 32
SESSION_SECRET=
